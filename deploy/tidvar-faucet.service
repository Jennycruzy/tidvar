[Unit]
Description=Tidvar testnet faucet: funds a new testnet tab with 0.0005 TAZ so judges can try it without a wallet
After=network-online.target tidvar-api.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/tidvar/deploy/faucet.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/tidvar-data /root/tidvar-private
UMask=0077

[Install]
WantedBy=multi-user.target
